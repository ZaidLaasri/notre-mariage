{
  "version": 1,
  "projects": {
    "notre-mariage": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.scss"],
            "assets": [
              { "glob": "**/*", "input": "public" },
              { "glob": "runtime-config.json", "input": "src", "output": "/" }
            ],
            "outputPath": "dist/notre-mariage"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "650kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": { "buildTarget": "notre-mariage:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
